#!/usr/bin/env bash

# ==============================================================================
# AUR Auditor Script
# Busca paquetes en el AUR e inspecciona el PKGBUILD en busca de patrones
# o comandos potencialmente peligrosos o inusuales.
# ==============================================================================

# Colores para la salida en terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # Sin color

# 1. Detectar el AUR Helper instalado
if command -v paru &> /dev/null; then
    HELPER="paru"
elif command -v yay &> /dev/null; then
    HELPER="yay"
else
    echo -e "${RED}[!] Error: No se encontró 'paru' ni 'yay' en el sistema.${NC}"
    exit 1
fi

echo -e "${BLUE}[*] Usando helper:${NC} $HELPER"

# 2. Solicitar el término de búsqueda al usuario
read -p "Ingresa el nombre o palabra clave a buscar en AUR: " QUERY

if [[ -z "$QUERY" ]]; then
    echo -e "${RED}[!] Término de búsqueda vacío. Abortando.${NC}"
    exit 1
fi

echo -e "${BLUE}[*] Buscando coincidencias para '${QUERY}'...${NC}"

# 3. Obtener coincidencias del AUR
# Usamos -Ssq para obtener únicamente los nombres de paquetes que coinciden
mapfile -t MATCHES < <($HELPER -Ssq "$QUERY")

if [[ ${#MATCHES[@]} -eq 0 ]]; then
    echo -e "${RED}[!] No se encontraron paquetes en AUR que coincidan con '${QUERY}'.${NC}"
    exit 0
fi

# 4. Presentar menú de selección al usuario
echo -e "\n${YELLOW}Selecciona el paquete que deseas auditar:${NC}"
PS3="Ingresa el número de tu elección: "

select PKG_NAME in "${MATCHES[@]}"; do
    if [[ -n "$PKG_NAME" ]]; then
        echo -e "\n${BLUE}[*] Paquete seleccionado:${NC} ${GREEN}$PKG_NAME${NC}"
        break
    else
        echo -e "${RED}[!] Selección inválida. Intenta de nuevo.${NC}"
    fi
done

# 5. Obtener el PKGBUILD del paquete seleccionado
echo -e "${BLUE}[*] Obteniendo PKGBUILD de $PKG_NAME...${NC}\n"
PKGBUILD_CONTENT=$($HELPER -Gp "$PKG_NAME" 2>/dev/null)

if [[ -z "$PKGBUILD_CONTENT" ]]; then
    echo -e "${RED}[!] No se pudo obtener el PKGBUILD para $PKG_NAME.${NC}"
    exit 1
fi

# 6. Definir patrones sospechosos para auditar
# Redes y Gestores
PATTERNS_MANAGERS="npm|bun|npx|pip|pip3|gem|cargo"
PATTERNS_FETCHERS="curl|wget|fetch|base64|eval|exec"
PATTERNS_PIPES="curl.*\|.*bash|wget.*\|.*sh"

PATTERNS_ALL="($PATTERNS_MANAGERS|$PATTERNS_FETCHERS|$PATTERNS_PIPES)"

# 7. Escanear el PKGBUILD en busca de coincidencias
echo -e "=================================================="
echo -e "         ${YELLOW}RESULTADOS DEL ANÁLISIS${NC}"
echo -e "=================================================="

# Filtrar coincidencias resaltadas
MATCHED_LINES=$(echo "$PKGBUILD_CONTENT" | grep -iEw -n "$PATTERNS_ALL")

if [[ -n "$MATCHED_LINES" ]]; then
    echo -e "${RED}[⚠️ ALERTA] Se detectaron términos o comandos sospechosos/sensibles en el PKGBUILD:${NC}\n"
    
    # Mostrar líneas encontradas
    echo "$MATCHED_LINES" | while read -r line; do
        echo -e "  ${YELLOW}Línea${NC} $line"
    done

    echo -e "\n${RED}Revisa minuciosamente el código antes de decidir compilar o instalar este paquete.${NC}"
else
    echo -e "${GREEN}[OK] No se detectaron patrones sospechosos habituales (npm, bun, pip, curl|bash, etc.).${NC}"
    echo -e "Recuerda que esto no garantiza un 100% de seguridad; siempre es recomendable leer el PKGBUILD completo."
fi

echo -e "==================================================\n"

# 8. Opción para desplegar el PKGBUILD completo en pantalla
read -p "¿Deseas ver el PKGBUILD completo en pantalla? (s/N): " SHOW_FULL
if [[ "$SHOW_FULL" =~ ^[Ss]$ ]]; then
    echo -e "\n--- INICIO PKGBUILD ---"
    echo "$PKGBUILD_CONTENT"
    echo -e "--- FIN PKGBUILD ---\n"
fi
